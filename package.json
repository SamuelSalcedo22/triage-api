{
  "name": "triage-api",
  "version": "0.0.1",
  "description": "API de Triage y Priorización de Casos Clínicos (NEWS2 + reglas HTA/DM)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "levantar": "node scripts/levantar.mjs",
    "levantar:docker": "docker compose --profile completo up --build",
    "test:unit": "vitest run src --reporter=verbose",
    "test:arq": "vitest run test/arquitectura --reporter=verbose --silent=false",
    "test:e2e": "vitest run --config vitest.config.e2e.mts --reporter=verbose",
    "test:carga": "nest build && node test/carga/prueba-carga.mjs",
    "test:disponibilidad": "nest build && node test/disponibilidad/prueba-disponibilidad.mjs",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1",
    "test:todo": "node scripts/pruebas.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "autocannon": "^9.0.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
